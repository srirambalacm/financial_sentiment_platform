# Copy this file to `.env` and fill in your values.
# `.env` is gitignored so your key never gets committed.

# Free API key from https://finnhub.io/ (required for news ingestion).
FINNHUB_API_KEY=

# Optional overrides (defaults shown):
# FINSENT_PRICE_LOOKBACK_DAYS=365
# FINSENT_NEWS_LOOKBACK_DAYS=30
# FINSENT_REQUEST_DELAY=1.0
